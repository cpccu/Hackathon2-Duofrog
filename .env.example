# Use the Supabase project URL and publishable key (safe with RLS enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional OpenRouter model override.
OPENROUTER_MODEL=openai/gpt-4o-mini
